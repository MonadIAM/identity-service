# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

SERVICE_NAME="identity-service"
NODE_ENV="local"
API_VERSION="1"
APP_BASE_IMAGE="node:24.18.0-alpine3.24"
APP_HOST="0.0.0.0"
APP_PORT="4002"
THROTTLE_LIMIT="20"
THROTTLE_TTL="1m"
HSTS_MAX_AGE="1y"
BODY_LIMIT_BYTES="5242880"
ALLOWED_SERVICE_ORIGINS='["http://localhost:4000","http://localhost:4001","http://localhost:4002","http://localhost:4003"]'
ALLOWED_UI_ORIGINS='[]'
IDENTITY_SERVICE_URL="http://localhost:4002"
ACCESS_CONTROL_SERVICE_URL="http://localhost:4001"
NOTIFICATION_SERVICE_URL="http://localhost:4003"
TEMPLATE_SERVICE_URL="http://localhost:4000"
DOCS_OAUTH_CLIENT_ID="00000003-0000-4000-8000-130000000002"
ACCESS_CONTROL_GRPC_URL="access-control-service-app:50051"

# ---------------------------------------------------------------------------
# OpenTelemetry
# ---------------------------------------------------------------------------

OTEL_EXPORTER_OTLP_ENDPOINT="http://otel-collector:4317"
OTEL_LOG_LEVEL="INFO"
OTEL_LOGS_EXPORTER="none"
OTEL_TRACES_SAMPLER="parentbased_traceidratio"
OTEL_TRACES_SAMPLER_ARG="0.2"

# ---------------------------------------------------------------------------
# Loki
# ---------------------------------------------------------------------------

LOKI_ENABLED="true"
LOKI_URL="http://loki:3100"
LOKI_BATCH_INTERVAL="5"

# ---------------------------------------------------------------------------
# PostgreSQL - common
# ---------------------------------------------------------------------------

POSTGRES_DB="identity-service"
POSTGRES_POOL_MAX="2"
POSTGRES_POOL_IDLE_MS="30s"
POSTGRES_LOGGING="true"

# ---------------------------------------------------------------------------
# PostgreSQL - write
# ---------------------------------------------------------------------------

POSTGRES_WRITE_HOST="identity-postgresql"
POSTGRES_WRITE_PORT="5432"
POSTGRES_WRITE_POOL_MAX="2"
POSTGRES_WRITE_POOL_IDLE_MS="30s"

# ---------------------------------------------------------------------------
# PostgreSQL - read
# ---------------------------------------------------------------------------

POSTGRES_READ_HOST="identity-postgresql"
POSTGRES_READ_PORT="5432"

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------

REDIS_HOST="identity-redis"
REDIS_PORT="6379"
REDIS_DB_CACHE="0"
REDIS_DB_LIMITER="1"
REDIS_DB_QUEUE="2"

# ---------------------------------------------------------------------------
# Kafka
# ---------------------------------------------------------------------------

KAFKA_BROKER="kafka:29092"
KAFKA_RETRY_ATTEMPTS="10"
KAFKA_RETRY_INITIAL_TIME="300ms"
KAFKAJS_NO_PARTITIONER_WARNING="1"
KAFKA_DLQ_MAX_RETRIES="5"
KAFKA_DLQ_RETRY_BASE_DELAY="5s"
KAFKA_DLQ_RETRY_JITTER="1s"

# ---------------------------------------------------------------------------
# Schema Registry
# ---------------------------------------------------------------------------

SCHEMA_REGISTRY_URL="http://schema-registry-main:8080/apis/ccompat/v7"
SCHEMA_REGISTRY_ENABLED="true"

# ---------------------------------------------------------------------------
# BullMQ - cleanup
# ---------------------------------------------------------------------------

INACTIVE_ACCOUNT_TTL="365d"
PENDING_ACCOUNT_TTL="24h"
PENDING_INVITE_TTL="7d"
AUDIT_LOG_RETENTION_TTL="14d"
CHANGE_LOG_RETENTION_TTL="14d"
CLEANUP_BATCH_SIZE="100"
CLEANUP_BATCH_DELAY="5s"
CLEANUP_BATCH_BACKOFF_DELAY="10s"
CLEANUP_BATCH_ATTEMPTS="3"

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

DOCKER_NETWORK_KAFKA="kafka-net"
DOCKER_NETWORK_POSTGRES="postgres-net"
DOCKER_NETWORK_REDIS="redis-net"
DOCKER_NETWORK_VAULT="vault-net"
DOCKER_NETWORK_MONITORING="monitoring-net"

# ---------------------------------------------------------------------------
# Vault
# ---------------------------------------------------------------------------

VAULT_IMAGE="hashicorp/vault:1.21.3"
VAULT_AGENT_SOCKET_PATH="/vault/proxy/agent.sock"
VAULT_APPROLE_NAME="identity-service"
VAULT_TRANSIT_MOUNT="transit"
VAULT_TRANSIT_ACCESS_KEY="identity-access-token"
VAULT_TRANSIT_REFRESH_KEY="identity-refresh-token"
VAULT_TRANSIT_ID_KEY="identity-id-token"
VAULT_TRANSIT_TOTP_KEY="identity-totp-secret"
VAULT_TRANSIT_PAIRWISE_KEY="identity-pairwise-sub"
VAULT_TRANSIT_AUDIT_MASK_KEY="identity-audit-mask-hmac"
VAULT_TRANSIT_AUDIT_LOG_KEY="identity-audit-log-sig"
VAULT_ADDR="http://vault:8200"
VAULT_TOKEN="monadiam-local-vault-token"

# ---------------------------------------------------------------------------
# Cache TTLs
# ---------------------------------------------------------------------------

OTP_VERIFICATION_TTL="10m"
OTP_LOGIN_TTL="10m"
OTP_RESET_TTL="10m"
OAUTH_STATE_TTL="10m"
PENDING_2FA_TTL="10m"
ACCESS_CACHE_TTL="30m"
REAUTHENTICATION_TTL="10m"

# ---------------------------------------------------------------------------
# Authorization Code Flow
# ---------------------------------------------------------------------------

AUTHORIZATION_REQUEST_TTL="10m"
AUTHORIZATION_CODE_TTL="5m"
APPLICATION_PER_REALM_LIMIT="5"
INTERFACE_CLIENT_PER_APPLICATION_LIMIT="4"
INTERFACE_CLIENT_REDIRECT_URI_LIMIT="8"
SERVICE_CLIENT_PER_APPLICATION_LIMIT="12"

# ---------------------------------------------------------------------------
# OAuth Providers
# ---------------------------------------------------------------------------

OAUTH_GOOGLE_CLIENT_ID=""
OAUTH_GOOGLE_REDIRECT_URI=""
OAUTH_GITHUB_CLIENT_ID=""
OAUTH_GITHUB_REDIRECT_URI=""

# ---------------------------------------------------------------------------
# Authn & Security
# ---------------------------------------------------------------------------

ARGON2_TYPE="argon2id"
ARGON2_MEMORY_COST_KIB="19456"
ARGON2_HASH_LENGTH="32"
ARGON2_PARALLELISM="1"
ARGON2_TIME_COST="2"
ARGON2_VERSION="19"
JWT_ISSUER="http://localhost:4002"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
JWT_ID_TOKEN_TTL="15m"
SESSION_EXPIRY_DAYS="7d"
PENDING_TOKEN_EXPIRY_MINUTES="10m"
SESSION_MAX_ACTIVE_COUNT="10"
SESSION_REFRESH_IDEMPOTENCY_TTL="5s"
PASSWORD_VALIDATION_MODE="local"
PASSWORD_HISTORY_CHECK_DAYS="90d"
HIBP_REQUEST_TIMEOUT="1.5s"
HIBP_RANGE_URL="https://api.pwnedpasswords.com/range/"
