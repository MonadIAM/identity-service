# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

SERVICE_NAME="identity-service"
NODE_ENV="development"
API_VERSION="1"

APP_BASE_IMAGE="node:22.13.0-alpine3.21"
GRPC_HOST="0.0.0.0"
GRPC_PORT="50051"
APP_HOST="0.0.0.0"
APP_PORT="5001"
THROTTLE_LIMIT="20"
THROTTLE_TTL="60000"

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------

POSTGRES_IMAGE="postgres:17.2-alpine3.21"
POSTGRES_DB="identity-service"
POSTGRES_USER="lambdius"
POSTGRES_PASSWORD="d7J!t9fXz2Qw*1Vr"
POSTGRES_PORT="6011"
POSTGRES_REPLICA_PORT="6012"
POSTGRES_CONTAINER_PORT="5432"
POSTGRES_SSL="false"
POSTGRES_SSL_REJECT_UNAUTHORIZED="false"
POSTGRES_POOL_MAX="2"
POSTGRES_POOL_IDLE_MS="30000"
POSTGRES_LOGGING="true"
POSTGRES_CQRS_ENABLED="true"

# ---------------------------------------------------------------------------
# PostgreSQL - write
# ---------------------------------------------------------------------------

POSTGRES_WRITE_POOL_MAX="2"
POSTGRES_WRITE_POOL_IDLE_MS="30000"

# ---------------------------------------------------------------------------
# PostgreSQL - read
# ---------------------------------------------------------------------------

POSTGRES_READ_POOL_MAX="4"
POSTGRES_READ_POOL_IDLE_MS="30000"

# ---------------------------------------------------------------------------
# PostgreSQL - replication
# ---------------------------------------------------------------------------

POSTGRES_REPLICATION_USER="repl_user"
POSTGRES_REPLICATION_PASSWORD="R3pl!c4t0r#Str0ng"
POSTGRES_REPLICATION_SLOT="identity_replica_1"

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------

REDIS_IMAGE="redis:7.4.2-alpine3.21"
REDIS_PORT="7011"
REDIS_CONTAINER_PORT="6379"
REDIS_PASSWORD="12345"
REDIS_DB_CACHE="0"
REDIS_DB_LIMITER="1"
REDIS_DB_QUEUE="2"

# ---------------------------------------------------------------------------
# Kafka
# ---------------------------------------------------------------------------

KAFKA_BROKER="kafka:29092"
KAFKA_RETRY_ATTEMPTS="10"
KAFKA_RETRY_INITIAL_TIME="300"
DOCKER_NETWORK_NAME="kafka-net"
KAFKA_CONNECT_IMAGE="quay.io/debezium/connect:3.0"
KAFKA_CONNECT_PORT="8083"
KAFKAJS_NO_PARTITIONER_WARNING="1"

# ---------------------------------------------------------------------------
# Debezium
# ---------------------------------------------------------------------------

DEBEZIUM_INIT_IMAGE="alpine:3.21"

# ---------------------------------------------------------------------------
# Auth & Security
# ---------------------------------------------------------------------------

# Hashing (Argon2)
ARGON2_TYPE="argon2id"
ARGON2_MEMORY_COST_KIB="19456"
ARGON2_TIME_COST="2"
ARGON2_PARALLELISM="1"
ARGON2_HASH_LENGTH="32"
ARGON2_VERSION="19"

# JWT (ES256)
JWT_ISSUER="identity-service"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
JWT_PENDING_TTL="7d"
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""

# Session
SESSION_EXPIRY_DAYS="7"
PENDING_TOKEN_EXPIRY_MINUTES="10"

# Password
PASSWORD_HISTORY_CHECK_DAYS="90"

# ---------------------------------------------------------------------------
# Cache TTLs
# ---------------------------------------------------------------------------

OTP_VERIFICATION_TTL="600"
OTP_IDENTIFIER_TTL="600"
OTP_LOGIN_TTL="600"
OTP_RESET_TTL="600"
PENDING_2FA_TTL="6000"
OAUTH_STATE_TTL="600"
ELEVATED_ACCESS_TTL="600"
ACCESS_CACHE_TTL="1800"

# ---------------------------------------------------------------------------
# OAuth Providers
# ---------------------------------------------------------------------------

OAUTH_GOOGLE_CLIENT_ID=""
OAUTH_GOOGLE_CLIENT_SECRET=""
OAUTH_GOOGLE_REDIRECT_URI=""

OAUTH_GITHUB_CLIENT_ID=""
OAUTH_GITHUB_CLIENT_SECRET=""
OAUTH_GITHUB_REDIRECT_URI=""

# ---------------------------------------------------------------------------
# AWS (SES/SNS)
# ---------------------------------------------------------------------------

AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
EMAIL_FROM=""

# ---------------------------------------------------------------------------
# BullMQ - cleanup
# ---------------------------------------------------------------------------

INACTIVE_ACCOUNT_TTL="365d"
PENDING_ACCOUNT_TTL="24h"
CLEANUP_BATCH_SIZE="100"
