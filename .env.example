# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

SERVICE_NAME="identity-service" # Service name.
NODE_ENV="development"          # Application environment mode.
API_VERSION="1"                 # API version prefix (e.g. 1 -> /api/v1).

APP_BASE_IMAGE="node:22.13.0-alpine3.21"                 # Base Docker image for building and running the Node.js app.
APP_HOST="0.0.0.0"                                       # Network interface the application will listen on.
APP_PORT="5002"                                          # HTTP server port.
THROTTLE_LIMIT="20"                                      # Max requests per IP within the TTL window.
THROTTLE_TTL="60000"                                     # Time window in milliseconds for rate limit calculation.
JWT_SECRET="" # Symmetric secret key used for signing and verifying JWT tokens (HS256/HS512).

# ---------------------------------------------------------------------------
# PostgreSQL - common
# ---------------------------------------------------------------------------

POSTGRESQL_IMAGE="postgres:17.2-alpine3.21" # PostgreSQL Docker image (for legacy / single-node setups).
POSTGRESQL_PORT="5442"                      # Host port mapped to primary container (host:5442 -> container:5432).
POSTGRESQL_REPLICA_PORT="5443"              # Host port mapped to replica container (host:5443 -> container:5432).
POSTGRESQL_CONTAINER_PORT="5432"            # Internal PostgreSQL port inside container (default 5432).
POSTGRESQL_USER="lambdius"                  # DB user with connection and schema management privileges.
POSTGRESQL_PASSWORD="d7J!t9fXz2Qw*1Vr"      # DB user password.
POSTGRESQL_NAME="identity-service"          # Database name used by the service.
POSTGRESQL_SSL="false"                      # Enable SSL for DB connection.
POSTGRESQL_SSL_REJECT_UNAUTHORIZED="false"  # Verify server certificate.
POSTGRESQL_POOL_IDLE_MS="30000"             # Connection idle timeout in pool (ms). 30000 = 30s.
POSTGRESQL_POOL_MAX="2"                     # Max connections in pool per app process.
POSTGRESQL_LOGGING="false"                  # ORM/driver SQL and error logging. false in prod.
POSTGRESQL_CQRS_ENABLED="true"              # true — separate write/read connections, false — single-connection mode.
POSTGRESQL_HOST="postgresql-primary"        # PostgreSQL host for single-connection mode.

# ---------------------------------------------------------------------------
# PostgreSQL - write-side
# ---------------------------------------------------------------------------

POSTGRESQL_WRITE_HOST="postgresql-primary"  # Primary PostgreSQL instance host.
POSTGRESQL_WRITE_PORT="5432"                # Internal port of primary instance (container port).
POSTGRESQL_WRITE_POOL_MAX="2"               # Max connections in write-side pool.
POSTGRESQL_WRITE_POOL_IDLE_MS="30000"       # Write-side connection idle timeout (ms).

# ---------------------------------------------------------------------------
# PostgreSQL - read-side
# ---------------------------------------------------------------------------

POSTGRESQL_READ_HOST="postgresql-replica"   # Read-replica PostgreSQL host.
POSTGRESQL_READ_PORT="5432"                 # Internal port of replica instance (container port).
POSTGRESQL_READ_POOL_MAX="4"                # Max connections in read-side pool.
POSTGRESQL_READ_POOL_IDLE_MS="30000"        # Read-side connection idle timeout (ms).

# ---------------------------------------------------------------------------
# PostgreSQL - replication
# ---------------------------------------------------------------------------

POSTGRESQL_REPLICATION_USER="repl_user"             # Replication user (requires REPLICATION role).
POSTGRESQL_REPLICATION_PASSWORD="R3pl!c4t0r#Str0ng" # Replication user password.
POSTGRESQL_REPLICATION_SLOT="identity_replica_1"    # Physical replication slot name for read-replica.

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------

REDIS_IMAGE="redis:7.4.2-alpine3.21" # Redis Docker image.
REDIS_HOST="redis"                   # Redis server host within Docker network.
REDIS_PORT="6380"                    # Host port mapped to Redis (host:6380 -> container:6379).
REDIS_CONTAINER_PORT="6379"          # Default Redis port inside container.
REDIS_PASSWORD="12345"               # Redis access password.
REDIS_DB_CACHE="0"                   # DB index for data caching.
REDIS_DB_LIMITER="1"                 # DB index for rate limiters.
REDIS_DB_QUEUE="2"                   # DB index for task queues (BullMQ).

# ---------------------------------------------------------------------------
# Kafka
# ---------------------------------------------------------------------------

KAFKA_BROKER="kafka:29092"      # Kafka broker address within Docker network.
KAFKA_RETRY_ATTEMPTS="10"       # Number of connection retry attempts.
KAFKA_RETRY_INITIAL_TIME="300"  # Initial delay between retry attempts (ms).
DOCKER_NETWORK_NAME="kafka-net" # External network name for inter-service communication.
