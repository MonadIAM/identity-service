# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

SERVICE_NAME="identity-service"
NODE_ENV="development"
API_VERSION="1"

APP_BASE_IMAGE="node:22.13.0-alpine3.21"
GRPC_HOST="0.0.0.0"
GRPC_PORT="50051"
APP_HOST="0.0.0.0"
APP_PORT="5001"
THROTTLE_LIMIT="20"
THROTTLE_TTL="1m"
HSTS_MAX_AGE="1y"
BODY_LIMIT_BYTES="5242880"
ALLOWED_ORIGINS='["http://localhost:5002"]'
ACCESS_CONTROL_GRPC_URL="access-control-service:50051"

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------

POSTGRES_IMAGE="postgres:17.2-alpine3.21"
POSTGRES_DB="identity-service"
POSTGRES_USER="user"
POSTGRES_HOST="postgresql-primary"
POSTGRES_PORT="5432"
POSTGRES_PRIMARY_PUBLISHED_PORT="6021"
POSTGRES_REPLICA_PUBLISHED_PORT="6022"
POSTGRES_SSL="false"
POSTGRES_SSL_REJECT_UNAUTHORIZED="false"
POSTGRES_POOL_MAX="2"
POSTGRES_POOL_IDLE_MS="30s"
POSTGRES_LOGGING="true"
POSTGRES_CQRS_ENABLED="true"

# ---------------------------------------------------------------------------
# PostgreSQL - write
# ---------------------------------------------------------------------------

POSTGRES_WRITE_POOL_MAX="2"
POSTGRES_WRITE_POOL_IDLE_MS="30s"
POSTGRES_WRITE_HOST="postgresql-primary"

# ---------------------------------------------------------------------------
# PostgreSQL - read
# ---------------------------------------------------------------------------

POSTGRES_READ_POOL_MAX="4"
POSTGRES_READ_POOL_IDLE_MS="30s"
POSTGRES_READ_HOST="postgresql-replica"

# ---------------------------------------------------------------------------
# PostgreSQL - replication
# ---------------------------------------------------------------------------

POSTGRES_REPLICATION_USER="repl_user"
POSTGRES_REPLICATION_SLOT="identity_replica_1"

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------

REDIS_IMAGE="redis:7.4.2-alpine3.21"
REDIS_HOST="redis"
REDIS_PORT="6379"
REDIS_PUBLISHED_PORT="7011"
REDIS_DB_CACHE="0"
REDIS_DB_LIMITER="1"
REDIS_DB_QUEUE="2"

# ---------------------------------------------------------------------------
# Kafka
# ---------------------------------------------------------------------------

KAFKA_BROKER="kafka:29092"
KAFKA_RETRY_ATTEMPTS="10"
KAFKA_RETRY_INITIAL_TIME="300ms"
DOCKER_NETWORK_NAME="kafka-net"
KAFKA_CONNECT_IMAGE="quay.io/debezium/connect:3.0"
KAFKA_CONNECT_PORT="8083"
KAFKAJS_NO_PARTITIONER_WARNING="1"
KAFKA_DLQ_MAX_RETRIES="5"
KAFKA_DLQ_RETRY_BASE_DELAY="5s"
KAFKA_DLQ_RETRY_JITTER="1s"

# ---------------------------------------------------------------------------
# Debezium
# ---------------------------------------------------------------------------

DEBEZIUM_INIT_IMAGE="alpine:3.21"

# ---------------------------------------------------------------------------
# Vault
# ---------------------------------------------------------------------------

VAULT_IMAGE="hashicorp/vault:1.21.3"
VAULT_URL="http://vault:8200"
VAULT_PORT="8200"
VAULT_PUBLISHED_PORT="8200"
VAULT_ROOT_TOKEN="root"
VAULT_TOKEN="identity-service-dev"

VAULT_TRANSIT_MOUNT="transit"
VAULT_TRANSIT_ACCESS_KEY="identity-access-token"
VAULT_TRANSIT_ACCESS_ROTATION_PERIOD="24h"
VAULT_TRANSIT_ACCESS_RETAIN_VERSIONS="2"
VAULT_TRANSIT_REFRESH_KEY="identity-refresh-token"
VAULT_TRANSIT_REFRESH_ROTATION_PERIOD="168h"
VAULT_TRANSIT_REFRESH_RETAIN_VERSIONS="3"
VAULT_TRANSIT_TOTP_KEY="identity-totp-secret"
VAULT_TRANSIT_TOTP_ROTATION_PERIOD="720h"

VAULT_KEY_TRIM_SCHEDULE="0 * * * *"

VAULT_KV_MOUNT="kv"
VAULT_KV_OAUTH_PATH="identity-service/oauth"
VAULT_KV_RUNTIME_PATH="identity-service/runtime"
VAULT_KV_REPLICATION_PATH="infrastructure/postgresql-replication"

# ---------------------------------------------------------------------------
# Cache TTLs
# ---------------------------------------------------------------------------

OTP_VERIFICATION_TTL="10m"
OTP_LOGIN_TTL="10m"
OTP_RESET_TTL="10m"
PENDING_2FA_TTL="10m"
OAUTH_STATE_TTL="10m"
ACCESS_CACHE_TTL="30m"
ELEVATED_ACCESS_TTL="10m"

# ---------------------------------------------------------------------------
# OAuth Providers
# ---------------------------------------------------------------------------

OAUTH_GOOGLE_CLIENT_ID=""
OAUTH_GOOGLE_REDIRECT_URI=""

OAUTH_GITHUB_CLIENT_ID=""
OAUTH_GITHUB_REDIRECT_URI=""

# ---------------------------------------------------------------------------
# AWS (SES/SNS)
# ---------------------------------------------------------------------------

AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
EMAIL_FROM=""

# ---------------------------------------------------------------------------
# BullMQ - cleanup
# ---------------------------------------------------------------------------

INACTIVE_ACCOUNT_TTL="365d"
PENDING_ACCOUNT_TTL="24h"
CLEANUP_BATCH_BACKOFF_DELAY="10s"
CLEANUP_BATCH_DELAY="5s"
CLEANUP_BATCH_ATTEMPTS="3"
CLEANUP_BATCH_SIZE="100"

# ---------------------------------------------------------------------------
# Authn & Security
# ---------------------------------------------------------------------------

# Hashing (Argon2)
ARGON2_TYPE="argon2id"
ARGON2_MEMORY_COST_KIB="19456"
ARGON2_TIME_COST="2"
ARGON2_PARALLELISM="1"
ARGON2_HASH_LENGTH="32"
ARGON2_VERSION="19"

# JWT
JWT_ISSUER="identity-service"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Session
SESSION_EXPIRY_DAYS="7d"
PENDING_TOKEN_EXPIRY_MINUTES="10m"
SESSION_MAX_ACTIVE_COUNT="10"

# Password
PASSWORD_HISTORY_CHECK_DAYS="90d"
