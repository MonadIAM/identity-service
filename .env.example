# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

SERVICE_NAME="identity-service"
NODE_ENV="development"
API_VERSION="1"

APP_BASE_IMAGE="node:22.13.0-alpine3.21"
APP_HOST="0.0.0.0"
APP_PORT="5002"
THROTTLE_LIMIT="20"
THROTTLE_TTL="60000"

# ---------------------------------------------------------------------------
# PostgreSQL - common
# ---------------------------------------------------------------------------

POSTGRESQL_IMAGE="postgres:17.2-alpine3.21"
POSTGRESQL_PORT="5442"
POSTGRESQL_REPLICA_PORT="5443"
POSTGRESQL_CONTAINER_PORT="5432"
POSTGRESQL_USER="lambdius"
POSTGRESQL_PASSWORD="d7J!t9fXz2Qw*1Vr"
POSTGRESQL_NAME="identity-service"
POSTGRESQL_SSL="false"
POSTGRESQL_SSL_REJECT_UNAUTHORIZED="false"
POSTGRESQL_POOL_IDLE_MS="30000"
POSTGRESQL_POOL_MAX="2"
POSTGRESQL_LOGGING="false"
POSTGRESQL_CQRS_ENABLED="true"
POSTGRESQL_HOST="postgresql-primary"

# ---------------------------------------------------------------------------
# PostgreSQL - write-side
# ---------------------------------------------------------------------------

POSTGRESQL_WRITE_HOST="postgresql-primary"
POSTGRESQL_WRITE_PORT="5432"
POSTGRESQL_WRITE_POOL_MAX="2"
POSTGRESQL_WRITE_POOL_IDLE_MS="30000"

# ---------------------------------------------------------------------------
# PostgreSQL - read-side
# ---------------------------------------------------------------------------

POSTGRESQL_READ_HOST="postgresql-replica"
POSTGRESQL_READ_PORT="5432"
POSTGRESQL_READ_POOL_MAX="4"
POSTGRESQL_READ_POOL_IDLE_MS="30000"

# ---------------------------------------------------------------------------
# PostgreSQL - replication
# ---------------------------------------------------------------------------

POSTGRESQL_REPLICATION_USER="repl_user"
POSTGRESQL_REPLICATION_PASSWORD="R3pl!c4t0r#Str0ng"
POSTGRESQL_REPLICATION_SLOT="identity_replica_1"

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------

REDIS_IMAGE="redis:7.4.2-alpine3.21"
REDIS_HOST="redis"
REDIS_PORT="6380"
REDIS_CONTAINER_PORT="6379"
REDIS_PASSWORD="12345"
REDIS_DB_CACHE="0"
REDIS_DB_LIMITER="1"
REDIS_DB_QUEUE="2"

# ---------------------------------------------------------------------------
# Kafka
# ---------------------------------------------------------------------------

KAFKA_BROKER="kafka:29092"
KAFKA_RETRY_ATTEMPTS="10"
KAFKA_RETRY_INITIAL_TIME="300"
DOCKER_NETWORK_NAME="kafka-net"

# ---------------------------------------------------------------------------
# Auth & Security
# ---------------------------------------------------------------------------

# Hashing (Argon2)
ARGON2_TYPE="argon2id"
ARGON2_MEMORY_COST_KIB="19456"
ARGON2_TIME_COST="2"
ARGON2_PARALLELISM="1"
ARGON2_HASH_LENGTH="32"
ARGON2_VERSION="19"

# JWT (ES256)
JWT_ISSUER="identity-service"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""

# Session
SESSION_EXPIRY_DAYS="7"

# Password
PASSWORD_HISTORY_CHECK_DAYS="90"

# ---------------------------------------------------------------------------
# Cache TTLs
# ---------------------------------------------------------------------------

OTP_VERIFICATION_TTL="600"
OTP_LOGIN_TTL="300"
OTP_RESET_TTL="600"
OAUTH_STATE_TTL="300"
PENDING_2FA_TTL="300"

# ---------------------------------------------------------------------------
# OAuth Providers
# ---------------------------------------------------------------------------

OAUTH_GOOGLE_CLIENT_ID=""
OAUTH_GOOGLE_CLIENT_SECRET=""
OAUTH_GOOGLE_REDIRECT_URI="http://localhost:5002/api/v1/auth/oauth/google/callback"

OAUTH_GITHUB_CLIENT_ID=""
OAUTH_GITHUB_CLIENT_SECRET=""
OAUTH_GITHUB_REDIRECT_URI="http://localhost:5002/api/v1/auth/oauth/github/callback"

# ---------------------------------------------------------------------------
# AWS (SES/SNS)
# ---------------------------------------------------------------------------

AWS_REGION="eu-central-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
EMAIL_FROM="noreply"

# ---------------------------------------------------------------------------
# BullMQ - cleanup
# ---------------------------------------------------------------------------

CLEANUP_BATCH_SIZE="500"
PENDING_ACCOUNT_TTL_HOURS="24"
NOTIFICATION_TTL_DAYS="60"
